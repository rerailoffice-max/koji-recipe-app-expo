    "web": "node scripts/apply-security-patches.mjs --check && expo start --web",
    "build:web": "node scripts/apply-security-patches.mjs --check && expo export -p web",
    "lint": "node scripts/apply-security-patches.mjs --check && expo lint",
    "security:patch": "node scripts/apply-security-patches.mjs",
    "security:verify": "node scripts/apply-security-patches.mjs --check",
    "postinstall": "npm run security:patch"
  },
  "dependencies": {
