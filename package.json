{
  "name": "koji-recipe-app-expo",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "node scripts/apply-security-patches.mjs --check && expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "node scripts/apply-security-patches.mjs --check && expo start --android",
